{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "青禾账本",
  "version": "0.3.0",
  "identifier": "com.qinghe.personalfinance",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "青禾账本 · 每一笔，心中有数",
        "width": 1440,
        "height": 1000,
        "minWidth": 900,
        "minHeight": 650,
        "backgroundColor": "#f7f8f4",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "useLocalToolsDir": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "本地个人财务管理",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/unbeatablesugar/Finance/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlFOTcxNTEwREExQTBBNkUKUldSdUNocmFFQldYbnNTRGp5bWUydk1qYVBqMWtmSGxUc2h6ZW95NE9makhSWjdNQnU5ZFBTVG0K",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
